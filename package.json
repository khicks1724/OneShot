{
  "name": "one-shot",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local server/index.js",
    "start": "node --env-file-if-exists=.env.local server/index.js",
    "build": "vite build && node scripts/widget.js",
    "test": "node --test tests/*.test.js",
    "check": "npm run test && npm run build",
    "test:e2e": "playwright test",
    "content": "node --env-file-if-exists=.env.local scripts/content.js",
    "configure-plugin": "node scripts/configure-plugin.js",
    "format": "prettier --write server src scripts tests *.js *.json *.html *.md docs/*.md .github/workflows/*.yml",
    "format:check": "prettier --check server src scripts tests *.js *.json *.html *.md docs/*.md .github/workflows/*.yml"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.1",
    "@modelcontextprotocol/sdk": "^1.20.2",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "openai": "^6.0.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.2",
    "vite": "^7.1.0"
  }
}
